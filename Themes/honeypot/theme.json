{
  "$schema": "https://schema.scene.example/theme/1.json",
  "format": 1,
  "id": "scene/honeypot",
  "version": "1.0.0",
  "name": "Honeypot",
  "summary": "Honey amber in a dark hive.",
  "authors": [
    {
      "name": "Scene"
    }
  ],
  "license": "MIT",
  "tags": [
    "dark",
    "yellow",
    "warm"
  ],
  "requires": {
    "scene": ">=1.0"
  },
  "variants": {
