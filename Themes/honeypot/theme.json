        "cursor": "@cursor",
        "cursorText": "@background",
        "selectionBackground": "@selection",
        "selectionForeground": "#f9edd7",
        "ansi": {
          "black": "#1d1106",
          "red": "#ed8c81",
          "green": "#8bd28d",
          "yellow": "#e3c566",
          "blue": "#75aef5",
          "magenta": "#d493d8",
          "cyan": "#44d6d6",
          "white": "#e5d6ba",
          "brightBlack": "#573f2a",
          "brightRed": "#ffa196",
          "brightGreen": "#99e89b",
          "brightYellow": "#fad86f",
          "brightBlue": "#91c1ff",
          "brightMagenta": "#eba3ef",
          "brightCyan": "#4aebeb",
          "brightWhite": "#f9edd7"
        }
      },
      "syntax": {
        "comment": {
          "color": "#977a61",
          "italic": true
        },
        "keyword": "#eba3ef",
        "operator": "#91c1ff",
        "punctuation": "#977a61",
        "string": "#8bd28d",
        "escape": "#eba3ef",
        "number": "#f6a56d",
        "constant": "#f6a56d",
        "function": "#75aef5",
        "type": "#e3c566",
        "builtin": "#44d6d6",
        "variable": "#e5d6ba",
        "parameter": {
          "color": "#44d6d6",
          "italic": true
