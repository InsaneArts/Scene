        "foreground": "#e5d6ba",
        "muted": "#977a61",
        "accent": "#f5b33b",
        "selection": "#412c05",
        "cursor": "#f9edd7",
        "currentLine": "#241608",
        "search": "#584723",
        "error": "#ed8c81",
        "warning": "#e3c566",
