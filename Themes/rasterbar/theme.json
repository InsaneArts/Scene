{
  "$schema": "https://schema.scene.example/theme/1.json",
  "format": 1,
  "id": "scene/rasterbar",
  "version": "1.0.0",
  "name": "Rasterbar",
  "summary": "Demoscene copper bars sliding over black.",
  "authors": [
    {
      "name": "Scene"
    }
  ],
  "license": "MIT",
  "tags": [
    "dark",
    "vivid",
    "retro"
  ],
  "requires": {
    "scene": ">=1.0"
  },
  "variants": {
    "dark": {
      "palette": {
        "background": "#070a18",
        "surface": "#03040f",
        "overlay": "#0e1426",
        "border": "#313953",
        "foreground": "#d0d7ec",
        "muted": "#747f9f",
        "accent": "#ed6cd5",
        "selection": "#381a32",
        "cursor": "#e9eefe",
        "currentLine": "#0a0f1f",
        "search": "#4b4015",
        "error": "#ff796d",
        "warning": "#ebbf0d",
        "success": "#6bd672",
        "info": "#67aaff"
      },
      "terminal": {
        "background": "@background",
        "foreground": "@foreground",
        "cursor": "@cursor",
        "cursorText": "@background",
        "selectionBackground": "@selection",
        "selectionForeground": "#e9eefe",
        "ansi": {
          "black": "#070a18",
          "red": "#ff796d",
          "green": "#6bd672",
          "yellow": "#ebbf0d",
          "blue": "#67aaff",
          "magenta": "#df81e5",
          "cyan": "#09d5d5",
          "white": "#d0d7ec",
          "brightBlack": "#313953",
          "brightRed": "#fe9c91",
          "brightGreen": "#79ec80",
          "brightYellow": "#ffd337",
          "brightBlue": "#8bbeff",
          "brightMagenta": "#f791fd",
          "brightCyan": "#0deaeb",
          "brightWhite": "#e9eefe"
        }
      },
      "syntax": {
        "comment": {
          "color": "#747f9f",
          "italic": true
        },
        "keyword": "#f791fd",
        "operator": "#8bbeff",
        "punctuation": "#747f9f",
        "string": "#6bd672",
        "escape": "#f791fd",
        "number": "#ff9b52",
        "constant": "#ff9b52",
        "function": "#67aaff",
        "type": "#ebbf0d",
        "builtin": "#09d5d5",
        "variable": "#d0d7ec",
        "parameter": {
          "color": "#09d5d5",
          "italic": true
        },
        "property": "#09d5d5",
        "tag": "#ff796d",
        "attribute": {
          "color": "#09d5d5",
          "italic": true
        },
        "added": "#6bd672",
        "removed": "#ff796d",
        "changed": "#ebbf0d"
      },
      "system": {
        "accentColor": "auto",
        "iconStyle": "dark"
      },
      "wallpapers": [
        {
          "file": "wallpapers/dark-bars.heic",
          "fit": "fill"
        },
        {
          "file": "wallpapers/dark-demo-bars.heic",
          "fit": "fill"
        },
        {
          "file": "wallpapers/dark-horizon.heic",
          "fit": "fill"
        }
      ]
    }
  },
  "assets": [
    {
      "file": "wallpapers/dark-bars.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Drawn for Scene with code"
    },
    {
      "file": "wallpapers/dark-demo-bars.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Generated for Scene with GPT Image"
    },
    {
      "file": "wallpapers/dark-horizon.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Drawn for Scene with code"
    }
  ]
}
