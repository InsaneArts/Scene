{
  "$schema": "https://schema.scene.example/theme/1.json",
  "format": 1,
  "id": "scene/solarpunk",
  "version": "1.0.0",
  "name": "Solarpunk",
  "summary": "Leaf green and sunlit gold on cream.",
  "authors": [
    {
      "name": "Scene"
    }
  ],
  "license": "MIT",
  "tags": [
    "light",
    "green",
    "warm"
  ],
  "requires": {
    "scene": ">=1.0"
  },
  "variants": {
    "light": {
      "palette": {
        "background": "#f9f6df",
        "surface": "#f0ecd1",
        "overlay": "#ece7c9",
        "border": "#bab596",
        "foreground": "#233226",
        "muted": "#777354",
        "accent": "#2d8336",
        "selection": "#b9dcb9",
        "cursor": "#101f13",
        "currentLine": "#f2eed4",
        "search": "#d9ce9d",
        "error": "#b24840",
        "warning": "#8d7102",
        "success": "#267d30",
        "info": "#2769b7"
      },
      "terminal": {
        "background": "@background",
        "foreground": "@foreground",
        "cursor": "@cursor",
        "cursorText": "@background",
        "selectionBackground": "@selection",
        "selectionForeground": "#101f13",
        "ansi": {
          "black": "#f9f6df",
          "red": "#b24840",
          "green": "#267d30",
          "yellow": "#8d7102",
          "blue": "#2769b7",
          "magenta": "#99519e",
          "cyan": "#057575",
          "white": "#233226",
          "brightBlack": "#bab596",
          "brightRed": "#c7534a",
          "brightGreen": "#2f8d39",
          "brightYellow": "#9e8003",
          "brightBlue": "#3077cd",
          "brightMagenta": "#ac5db1",
          "brightCyan": "#098585",
          "brightWhite": "#101f13"
        }
      },
      "syntax": {
        "comment": {
          "color": "#777354",
          "italic": true
        },
        "keyword": "#ac5db1",
        "operator": "#3077cd",
        "punctuation": "#777354",
        "string": "#267d30",
        "escape": "#ac5db1",
        "number": "#ac5701",
        "constant": "#ac5701",
        "function": "#2769b7",
        "type": "#8d7102",
        "builtin": "#057575",
        "variable": "#233226",
        "parameter": {
          "color": "#057575",
          "italic": true
        },
        "property": "#057575",
        "tag": "#b24840",
        "attribute": {
          "color": "#057575",
          "italic": true
        },
        "added": "#267d30",
        "removed": "#b24840",
        "changed": "#8d7102"
      },
      "system": {
        "accentColor": "green",
        "iconStyle": "default"
      },
      "wallpapers": [
        {
          "file": "wallpapers/light-garden-city.heic",
          "fit": "fill"
        },
        {
          "file": "wallpapers/light-leaf-light.heic",
          "fit": "fill"
        },
        {
          "file": "wallpapers/light-contours.heic",
          "fit": "fill"
        }
      ]
    }
  },
  "assets": [
    {
      "file": "wallpapers/light-garden-city.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Generated for Scene with GPT Image"
    },
    {
      "file": "wallpapers/light-leaf-light.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Generated for Scene with GPT Image"
    },
    {
      "file": "wallpapers/light-contours.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Drawn for Scene with code"
    }
  ]
}
