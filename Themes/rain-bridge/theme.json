      "system": {
        "accentColor": "auto",
        "iconStyle": "dark"
      },
      "wallpapers": [
        {
          "file": "wallpapers/dark-evening-shower.heic",
          "fit": "fill"
        },
        {
          "file": "wallpapers/dark-ferry.heic",
          "fit": "fill"
        },
        {
          "file": "wallpapers/dark-pines.heic",
          "fit": "fill"
        }
      ]
    }
