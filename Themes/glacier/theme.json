{
  "$schema": "https://schema.scene.example/theme/1.json",
  "format": 1,
  "id": "scene/glacier",
  "version": "1.0.0",
  "name": "Glacier",
  "summary": "Blue ice, white snow, and cold water.",
  "authors": [
    {
      "name": "Scene"
    }
  ],
  "license": "MIT",
  "tags": [
    "light",
    "blue",
    "cold"
  ],
  "requires": {
    "scene": ">=1.0"
  },
  "variants": {
    "light": {
      "palette": {
        "background": "#ebf8fc",
        "surface": "#deeff4",
        "overlay": "#d7eaf0",
        "border": "#a3b9c0",
        "foreground": "#1a3040",
        "muted": "#5f767e",
        "accent": "#017ca7",
        "selection": "#aed8ef",
        "cursor": "#061d2b",
        "currentLine": "#e1f1f6",
        "search": "#cfd0b1",
        "error": "#a94f47",
        "warning": "#8d7102",
        "success": "#357a3a",
        "info": "#346aac"
      },
      "terminal": {
        "background": "@background",
        "foreground": "@foreground",
        "cursor": "@cursor",
        "cursorText": "@background",
        "selectionBackground": "@selection",
        "selectionForeground": "#061d2b",
        "ansi": {
          "black": "#ebf8fc",
          "red": "#a94f47",
          "green": "#357a3a",
          "yellow": "#8d7102",
          "blue": "#346aac",
          "magenta": "#945798",
          "cyan": "#057575",
          "white": "#1a3040",
          "brightBlack": "#a3b9c0",
          "brightRed": "#be5b52",
          "brightGreen": "#3e8b44",
          "brightYellow": "#9e8003",
          "brightBlue": "#3d78c2",
          "brightMagenta": "#a763ab",
          "brightCyan": "#098585",
          "brightWhite": "#061d2b"
        }
      },
      "syntax": {
        "comment": {
          "color": "#5f767e",
          "italic": true
        },
        "keyword": "#a763ab",
        "operator": "#3d78c2",
        "punctuation": "#5f767e",
        "string": "#357a3a",
        "escape": "#a763ab",
        "number": "#a65c20",
        "constant": "#a65c20",
        "function": "#346aac",
        "type": "#8d7102",
        "builtin": "#057575",
        "variable": "#1a3040",
        "parameter": {
          "color": "#057575",
          "italic": true
        },
        "property": "#057575",
        "tag": "#a94f47",
        "attribute": {
          "color": "#057575",
          "italic": true
        },
        "added": "#357a3a",
        "removed": "#a94f47",
        "changed": "#8d7102"
      },
      "system": {
        "accentColor": "blue",
        "iconStyle": "default"
      },
      "wallpapers": [
        {
          "file": "wallpapers/light-ice-wall.heic",
          "fit": "fill"
        },
        {
          "file": "wallpapers/light-ice-macro.heic",
          "fit": "fill"
        },
        {
          "file": "wallpapers/light-contours.heic",
          "fit": "fill"
        }
      ]
    }
  },
  "assets": [
    {
      "file": "wallpapers/light-ice-wall.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Generated for Scene with GPT Image"
    },
    {
      "file": "wallpapers/light-ice-macro.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Generated for Scene with GPT Image"
    },
    {
      "file": "wallpapers/light-contours.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Drawn for Scene with code"
    }
  ]
}
