{
  "$schema": "https://schema.scene.example/theme/1.json",
  "format": 1,
  "id": "scene/moss",
  "version": "1.0.0",
  "name": "Moss",
  "summary": "Moss on wet stone.",
  "authors": [
    {
      "name": "Scene"
    }
  ],
  "license": "MIT",
  "tags": [
    "dark",
    "green",
    "earthy"
  ],
  "requires": {
    "scene": ">=1.0"
  },
  "variants": {
    "dark": {
      "palette": {
        "background": "#111810",
        "surface": "#0a1009",
        "overlay": "#1a2417",
        "border": "#3e4c3b",
        "foreground": "#d8dac3",
        "muted": "#758671",
        "accent": "#99c965",
        "selection": "#283916",
        "cursor": "#eff0de",
        "currentLine": "#161e14",
        "search": "#4e4b2c",
        "error": "#e58c82",
        "warning": "#dec26d",
        "success": "#8dcd8e",
        "info": "#77abec"
      },
      "terminal": {
        "background": "@background",
        "foreground": "@foreground",
        "cursor": "@cursor",
        "cursorText": "@background",
        "selectionBackground": "@selection",
        "selectionForeground": "#eff0de",
        "ansi": {
          "black": "#111810",
          "red": "#e58c82",
          "green": "#8dcd8e",
          "yellow": "#dec26d",
          "blue": "#77abec",
          "magenta": "#ce92d1",
          "cyan": "#53d1d0",
          "white": "#d8dac3",
          "brightBlack": "#3e4c3b",
          "brightRed": "#fe9c91",
          "brightGreen": "#9be39d",
          "brightYellow": "#f4d576",
          "brightBlue": "#8bbeff",
          "brightMagenta": "#e5a3e8",
          "brightCyan": "#59e6e6",
          "brightWhite": "#eff0de"
        }
      },
      "syntax": {
        "comment": {
          "color": "#758671",
          "italic": true
        },
        "keyword": "#e5a3e8",
        "operator": "#8bbeff",
        "punctuation": "#758671",
        "string": "#8dcd8e",
        "escape": "#e5a3e8",
        "number": "#eea471",
        "constant": "#eea471",
        "function": "#77abec",
        "type": "#dec26d",
        "builtin": "#53d1d0",
        "variable": "#d8dac3",
        "parameter": {
          "color": "#53d1d0",
          "italic": true
        },
        "property": "#53d1d0",
        "tag": "#e58c82",
        "attribute": {
          "color": "#53d1d0",
          "italic": true
        },
        "added": "#8dcd8e",
        "removed": "#e58c82",
        "changed": "#dec26d"
      },
      "system": {
        "accentColor": "green",
        "iconStyle": "dark"
      },
      "wallpapers": [
        {
          "file": "wallpapers/dark-stone.heic",
          "fit": "fill"
        },
        {
          "file": "wallpapers/dark-forest-floor.heic",
          "fit": "fill"
        },
        {
          "file": "wallpapers/dark-contours.heic",
          "fit": "fill"
        }
      ]
    }
  },
  "assets": [
    {
      "file": "wallpapers/dark-stone.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Generated for Scene with GPT Image"
    },
    {
      "file": "wallpapers/dark-forest-floor.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Generated for Scene with GPT Image"
    },
    {
      "file": "wallpapers/dark-contours.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Drawn for Scene with code"
    }
  ]
}
