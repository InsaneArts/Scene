{
  "$schema": "https://schema.scene.example/theme/1.json",
  "format": 1,
  "id": "scene/deep-field",
  "version": "1.0.0",
  "name": "Deep Field",
  "summary": "A black sky full of distant gold and blue galaxies.",
  "authors": [
    {
      "name": "Scene"
    }
  ],
  "license": "MIT",
  "tags": [
    "dark",
    "space"
  ],
  "requires": {
    "scene": ">=1.0"
  },
  "variants": {
    "dark": {
      "palette": {
        "background": "#05070d",
        "surface": "#020306",
        "overlay": "#0d101a",
        "border": "#303544",
        "foreground": "#d0d8e5",
        "muted": "#798094",
        "accent": "#eec066",
        "selection": "#2d1f01",
        "cursor": "#e8effa",
        "currentLine": "#090c14",
        "search": "#484024",
        "error": "#f2897e",
        "warning": "#e6c45a",
        "success": "#86d489",
        "info": "#70adfb"
      },
      "terminal": {
        "background": "@background",
        "foreground": "@foreground",
        "cursor": "@cursor",
        "cursorText": "@background",
        "selectionBackground": "@selection",
        "selectionForeground": "#e8effa",
        "ansi": {
          "black": "#05070d",
          "red": "#f2897e",
          "green": "#86d489",
          "yellow": "#e6c45a",
          "blue": "#70adfb",
          "magenta": "#d790db",
          "cyan": "#2ad7d7",
          "white": "#d0d8e5",
          "brightBlack": "#303544",
          "brightRed": "#ffa196",
          "brightGreen": "#94e997",
          "brightYellow": "#fcd863",
          "brightBlue": "#91c1ff",
          "brightMagenta": "#eea0f3",
          "brightCyan": "#2eeded",
          "brightWhite": "#e8effa"
        }
      },
      "syntax": {
        "comment": {
          "color": "#798094",
          "italic": true
        },
        "keyword": "#eea0f3",
        "operator": "#91c1ff",
        "punctuation": "#798094",
        "string": "#86d489",
        "escape": "#eea0f3",
        "number": "#faa365",
        "constant": "#faa365",
        "function": "#70adfb",
        "type": "#e6c45a",
        "builtin": "#2ad7d7",
        "variable": "#d0d8e5",
        "parameter": {
          "color": "#2ad7d7",
          "italic": true
        },
        "property": "#2ad7d7",
        "tag": "#f2897e",
        "attribute": {
          "color": "#2ad7d7",
          "italic": true
        },
        "added": "#86d489",
        "removed": "#f2897e",
        "changed": "#e6c45a"
      },
      "system": {
        "accentColor": "auto",
        "iconStyle": "dark"
      },
      "wallpapers": [
        {
          "file": "wallpapers/dark-galaxies.heic",
          "fit": "fill"
        },
        {
          "file": "wallpapers/dark-nebula.heic",
          "fit": "fill"
        },
        {
          "file": "wallpapers/dark-spiral.heic",
          "fit": "fill"
        }
      ]
    }
  },
  "assets": [
    {
      "file": "wallpapers/dark-galaxies.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Generated for Scene with GPT Image"
    },
    {
      "file": "wallpapers/dark-nebula.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Drawn for Scene with code"
    },
    {
      "file": "wallpapers/dark-spiral.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Generated for Scene with GPT Image"
    }
  ]
}
