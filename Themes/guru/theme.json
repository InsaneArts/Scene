{
  "$schema": "https://schema.scene.example/theme/1.json",
  "format": 1,
  "id": "scene/guru",
  "version": "1.0.0",
  "name": "Guru",
  "summary": "Black, gray, and one red alert box.",
  "authors": [
    {
      "name": "Scene"
    }
  ],
  "license": "MIT",
  "tags": [
    "dark",
    "red",
    "minimal"
  ],
  "requires": {
    "scene": ">=1.0"
  },
  "variants": {
    "dark": {
      "palette": {
        "background": "#090707",
        "surface": "#040303",
        "overlay": "#150f0f",
        "border": "#3d3332",
        "foreground": "#dbd6d6",
        "muted": "#8b7c7c",
        "accent": "#ed413b",
        "selection": "#3a1411",
        "cursor": "#f2eded",
        "currentLine": "#0f0b0b",
        "search": "#473f2b",
        "error": "#db9289",
        "warning": "#d9c37f",
        "success": "#96ca97",
        "info": "#81abe0"
      },
      "terminal": {
        "background": "@background",
        "foreground": "@foreground",
        "cursor": "@cursor",
        "cursorText": "@background",
        "selectionBackground": "@selection",
        "selectionForeground": "#f2eded",
        "ansi": {
          "black": "#090707",
          "red": "#db9289",
          "green": "#96ca97",
          "yellow": "#d9c37f",
          "blue": "#81abe0",
          "magenta": "#c897ca",
          "cyan": "#6ecdcc",
          "white": "#dbd6d6",
          "brightBlack": "#3d3332",
          "brightRed": "#f4a298",
          "brightGreen": "#a5e0a5",
          "brightYellow": "#efd689",
          "brightBlue": "#8fbefa",
          "brightMagenta": "#dfa8e1",
          "brightCyan": "#76e2e2",
          "brightWhite": "#f2eded"
        }
      },
      "syntax": {
        "comment": {
          "color": "#8b7c7c",
          "italic": true
        },
        "keyword": "#dfa8e1",
        "operator": "#8fbefa",
        "punctuation": "#8b7c7c",
        "string": "#96ca97",
        "escape": "#dfa8e1",
        "number": "#e5a880",
        "constant": "#e5a880",
        "function": "#81abe0",
        "type": "#d9c37f",
        "builtin": "#6ecdcc",
        "variable": "#dbd6d6",
        "parameter": {
          "color": "#6ecdcc",
          "italic": true
        },
        "property": "#6ecdcc",
        "tag": "#db9289",
        "attribute": {
          "color": "#6ecdcc",
          "italic": true
        },
        "added": "#96ca97",
        "removed": "#db9289",
        "changed": "#d9c37f"
      },
      "system": {
        "accentColor": "red",
        "iconStyle": "dark"
      },
      "wallpapers": [
        {
          "file": "wallpapers/dark-alarm-light.heic",
          "fit": "fill"
        },
        {
          "file": "wallpapers/dark-trace.heic",
          "fit": "fill"
        },
        {
          "file": "wallpapers/dark-ridges.heic",
          "fit": "fill"
        }
      ]
    }
  },
  "assets": [
    {
      "file": "wallpapers/dark-alarm-light.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Generated for Scene with GPT Image"
    },
    {
      "file": "wallpapers/dark-trace.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Drawn for Scene with code"
    },
    {
      "file": "wallpapers/dark-ridges.heic",
      "license": "LicenseRef-Scene",
      "attribution": "Drawn for Scene with code"
    }
  ]
}
